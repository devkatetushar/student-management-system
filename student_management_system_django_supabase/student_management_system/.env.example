# Copy this file to .env and fill in your own values.
SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase Dashboard -> Connect -> Session pooler (recommended for many local networks)
# Paste the PostgreSQL URI here and URL-encode special characters in the password if needed.
# Example shape: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
